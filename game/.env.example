# このファイルを .env にコピーしてキーを書く(.env は git に入らない)
# 既定は OpenAI だけで動く(司令役・作戦ごとの担当・音声認識)
OPENAI_API_KEY=
# 以下は省略可
# COMMANDER_MODEL=gpt-5.4-mini     # 解釈の質を上げるなら gpt-5.5
# COMMANDER_EFFORT=low             # 推論の深さ: none / minimal / low / medium / high(モデルにより使える値が違う)
# OFFICER_MODEL=gpt-5.4-nano
# OFFICER_EFFORT=low
# STT_MODEL=gpt-4o-transcribe
#
# Claude を使う場合
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
