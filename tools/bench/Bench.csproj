<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../game/src/Sim/**/*.cs" Link="Sim/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../game/src/Command/**/*.cs" Link="Command/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../game/src/Llm/**/*.cs" Link="Llm/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../game/src/View/DemoScenario.cs" Link="View/DemoScenario.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.9.0" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
  </ItemGroup>
</Project>
