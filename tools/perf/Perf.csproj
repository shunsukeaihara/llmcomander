<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../game/src/Sim/**/*.cs" Link="Sim/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../game/src/Command/**/*.cs" Link="Command/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
